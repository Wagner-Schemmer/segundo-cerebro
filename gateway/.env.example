# Copie para .env e preencha
TELEGRAM_BOT_TOKEN=

OLLAMA_URL=http://localhost:11434
# Modelos que cabem na sua RAM (escolha 1 pra começar):
#   qwen2.5:1.5b  (~1 GB)  <- recomendado pra começar
#   gemma2:2b     (~1,6 GB)
#   llama3.2:3b   (~2 GB)  <- melhor qualidade, usar com RAM folgada
OLLAMA_MODEL=qwen2.5:1.5b
# Contexto baixo = menos RAM
OLLAMA_NUM_CTX=2048
# Descarrega o modelo da RAM após 5 min sem uso
OLLAMA_KEEP_ALIVE=5m

CEREBRO_DIR=cerebro
