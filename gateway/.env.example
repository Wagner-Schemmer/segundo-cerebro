# ===== Copie este arquivo para .env e preencha =====
cp .env.example .env

# ===== Chaves de IA (Fase 1) =====
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini: https://aistudio.google.com/apikey (tem camada gratuita!)
GOOGLE_API_KEY=

# Hermes + 300 modelos via OpenRouter: https://openrouter.ai
OPENROUTER_API_KEY=

# ===== WhatsApp/Evolution API (Fase 2) =====
EVOLUTION_API_KEY=troque-por-uma-chave-segura-aqui

# ===== Telegram (Fase 1) =====
# Token gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ===== Postgres central (hub do cérebro) =====
DATABASE_URL=postgresql://cerebro:cerebro@localhost:5432/cerebro_central
